rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches auth.uid)
    // Fields:
    //   - uid: string (required) - The unique ID of the user.
    //   - email: string (required, email format) - The email of the user.
    //   - displayName: string (optional) - The display name of the user.
    //   - role: string (required, enum: ['admin', 'client']) - The role of the user.
    //   - createdAt: string (required, date-time format) - When the user profile was created.
    //
    // Collection: bookings
    // Document ID: {bookingId} (auto-generated)
    // Fields:
    //   - id: string (optional) - The unique ID of the booking.
    //   - fullName: string (required, size: 1-100) - The name of the person booking.
    //   - phone: string (required, size: 1-20) - The phone number of the person booking.
    //   - email: string (required) - The email of the person booking.
    //   - consent: bool (required) - Consent to terms.
    //   - hospitalId: string (required) - The ID of the hospital being booked.
    //   - hospitalName: string (required) - The name of the hospital being booked.
    //   - date: string (required, date format) - The date of the visit.
    //   - status: string (required, enum: ['pending', 'confirmed', 'cancelled']) - The status of the booking.
    //   - userUid: string (required, matches auth.uid) - The UID of the user who made the booking.
    //   - loginEmail: string (optional, email format) - The login email of the user who made the booking.
    //   - tenantId: string (required) - The ID of the partner/tenant.
    //   - createdAt: string (required, date-time format) - When the booking was created.
    //
    // Collection: partners
    // Document ID: {partnerId} (auto-generated)
    // Fields:
    //   - id: string (optional)
    //   - name: string (required)
    //   - tenantId: string (required, unique)
    //   - adminEmail: string (required, email format)
    //   - seoTitle: string (required)
    //   - displayTitle: string (required)
    //   - kakaoLink: string (optional)
    //   - createdAt: string (required, date-time format)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "osec0521@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidEmail(email) {
      return email is string && email.matches(".+@.+\\..+");
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$");
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
             hasOnlyAllowedFields(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             isValidEmail(data.email) &&
             data.role in ['admin', 'client'] &&
             data.createdAt is string;
    }

    function isValidBooking(data) {
      return hasRequiredFields(['fullName', 'phone', 'email', 'consent', 'hospitalId', 'hospitalName', 'date', 'status', 'userUid', 'createdAt', 'tenantId']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.email is string && isValidEmail(data.email) &&
             data.consent is bool &&
             data.hospitalId is string &&
             data.hospitalName is string &&
             isValidDateString(data.date) &&
             data.status in ['pending', 'confirmed', 'cancelled'] &&
             data.userUid is string && data.userUid == request.auth.uid &&
             (data.loginEmail == null || isValidEmail(data.loginEmail)) &&
             data.tenantId is string &&
             data.createdAt is string;
    }

    function isValidPartner(data) {
      return hasRequiredFields(['name', 'tenantId', 'adminEmail', 'seoTitle', 'displayTitle', 'createdAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.tenantId is string && data.tenantId.size() > 0 &&
             isValidEmail(data.adminEmail) &&
             data.seoTitle is string &&
             data.displayTitle is string &&
             (data.kakaoLink == null || data.kakaoLink is string) &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) &&
                      ((isOwner(userId) && request.resource.data.role == 'client') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) &&
                      ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBooking(request.resource.data);
      allow update: if isAuthenticated() && (
                      (resource.data.userUid == request.auth.uid && isValidBooking(request.resource.data) && request.resource.data.status == resource.data.status) ||
                      isAdmin()
                    );
      allow delete: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true; // Publicly readable for tenant lookup
      allow create, update, delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
